# Required: Eventbrite private token (Account Settings -> Developer Links -> API Keys -> Private token)
EVENTBRITE_TOKEN=
# Optional: defaults to the 2026 tailgate event
EVENTBRITE_EVENT_ID=2003945094723
# Optional fallback: AASU hold sizes, used only if Eventbrite sections can't be read
# AASU_HOLDS=HBS=125,HLS=15,SOM=40,YLS=20
# Required: one password per party (login page). HBS and AASU see AASU data; HLS, SOM, YLS don't.
PASSWORD_HBS=
PASSWORD_HLS=
PASSWORD_SOM=
PASSWORD_YLS=
PASSWORD_AASU=
